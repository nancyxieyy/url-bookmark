{
  "manifest_version": 3,
  "name": "URL Bookmark Capture",
  "version": "1.1.0",
  "description": "自动抓取当前网页并保存到 URL Bookmark。",
  "permissions": ["activeTab", "notifications"],
  "host_permissions": [
    "https://url-bookmark.onrender.com/*"
  ],
  "action": {
    "default_title": "收藏当前网页",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "quick-save-inbox": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "快速保存当前网页到 Inbox"
    }
  }
}
