# Local development uses SQLite when DATABASE_URL is omitted.
# For Supabase/Render, paste the Postgres connection string into the host's
# secret manager, never into this file in a real deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
APP_USERNAME=admin
APP_PASSWORD=replace-with-a-long-random-password
DEEPSEEK_API_KEY=replace-with-a-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
